# В папке data наружу едут только два файла: списки слов и план обхода.
# Остальное — база, ключ сессий и выгрузки закладок владельца — личное.
data/*
!data/markers.json
!data/crawl_plan.json
!data/aliases.json
!data/dictionaries.json
# автоперевод названий лиг: словарь спортивных слов (владелец 12.10.2026)
!data/league_words.json
# кнопка ↗: страница канала на дату по сайтам (владелец 13.10.2026)
!data/channel_pages.json
# языки служебных слов (книга 084, 25.10): без него разбор на GitHub не знает, где чьё слово
!data/word_langs.json

# служебное для Claude Code
.claude/

# установщики и прочий крупняк, случайно попавший в папку
*.exe
*.msi
*.zip
# срезы страниц сборов для книги случаев — кладутся нарочно (kniga/README.md)
